<?xml version="1.0" encoding="utf-8"?>
<!--
    Declares the AID (Application ID) that our HCE service responds to.
    AID F0414E524F424541 = F0 + "ANROBEA" (proprietary range, must start with F0).
    Category "other" so Android does not conflict with payment AIDs.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/app_name"
    android:requireDeviceUnlock="false">

    <aid-group
        android:category="other"
        android:description="@string/app_name">
        <aid-filter android:name="F0414E524F424541" />
    </aid-group>

</host-apdu-service>
