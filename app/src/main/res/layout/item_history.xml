<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"
    android:padding="14dp"
    android:background="@drawable/glass_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Direction Emoji + Label -->
        <LinearLayout
            android:id="@+id/layoutDir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true">

            <TextView
                android:id="@+id/txtHistoryIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📥"
                android:textSize="18sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/txtHistoryDir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Received"
                android:textColor="@color/app_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status pill -->
        <TextView
            android:id="@+id/txtHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Success"
            android:textColor="@color/brand_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <TextView
        android:id="@+id/txtHistoryFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="file1.mp4, file2.png"
        android:textColor="@color/app_text"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/txtHistorySize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45.2 MB"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/txtHistoryTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21:50 · 19 Jul"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</LinearLayout>
