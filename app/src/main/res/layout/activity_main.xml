<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space_planet"
    android:keepScreenOn="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ═══════════════════════════════════════════ -->
            <!-- MODE SELECTION SCREEN                       -->
            <!-- ═══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutModeSelection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="28dp"
                android:visibility="visible">

                <!-- Settings row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/btnSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="⚙"
                        android:textSize="22sp"
                        android:textColor="@color/app_text_secondary"
                        android:padding="8dp"
                        android:contentDescription="Settings" />
                </RelativeLayout>

                <!-- Brand header -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="anro"
                    android:textColor="@color/app_text"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.35"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEAM"
                    android:textColor="@color/brand_primary"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <!-- version hidden — tap ⚙ for Settings -->


                <!-- Logo -->
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginBottom="40dp"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="ANRO-BEAM logo" />

                <!-- Tagline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What would you like to do?"
                    android:textColor="@color/app_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="28dp" />

                <!-- 📤 SHARE MODE Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardShareMode"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/glass_background_color"
                    app:strokeColor="@color/brand_primary"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:text="📤"
                            android:textSize="34sp"
                            android:gravity="center" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Share"
                                android:textColor="@color/app_text"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Send a file to another device"
                                android:textColor="@color/app_text_secondary"
                                android:textSize="13sp"
                                android:layout_marginTop="3dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/brand_primary"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 📥 RECEIVE MODE Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReceiveMode"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/glass_background_color"
                    app:strokeColor="@color/glass_stroke_color"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:text="📥"
                            android:textSize="34sp"
                            android:gravity="center" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Receive"
                                android:textColor="@color/app_text"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wait for a file from another device"
                                android:textColor="@color/app_text_secondary"
                                android:textSize="13sp"
                                android:layout_marginTop="3dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/app_text_secondary"
                            android:textSize="28sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Status panel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/glass_background">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Bluetooth" android:textColor="@color/app_text" android:textSize="14sp" android:textStyle="bold"
                            android:layout_alignParentStart="true" />
                        <TextView android:id="@+id/txtBluetoothStatusVal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Checking..." android:textColor="@color/brand_primary" android:textSize="14sp" android:textStyle="bold"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/glass_stroke_color" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Internet" android:textColor="@color/app_text" android:textSize="14sp" android:textStyle="bold"
                            android:layout_alignParentStart="true" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Not Required" android:textColor="@color/app_text_secondary" android:textSize="14sp"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                </LinearLayout>

                <!-- Permission button -->
                <TextView
                    android:id="@+id/btnPermissionSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="⚠ Grant Permissions"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════ -->
            <!-- SHARE HOME SCREEN                           -->
            <!-- ═══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutShareHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp"
                android:visibility="gone">

                <!-- Back Button row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:id="@+id/btnShareBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="‹ Back"
                        android:textColor="@color/brand_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:layout_alignParentStart="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📤 Share Mode"
                        android:textColor="@color/app_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_centerInParent="true" />
                </RelativeLayout>

                <!-- File Picker Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardChooseFile"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/glass_background_color"
                    app:strokeColor="@color/brand_primary"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📁"
                            android:textSize="40sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/btnChooseFileText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Choose File"
                            android:textColor="@color/app_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/selectedFileSubtext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to select a file to share"
                            android:textColor="@color/app_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:maxWidth="260dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Find & Send button (visible after file selected) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendFile"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="Find Receiver and Send"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:backgroundTint="@color/brand_primary"
                    android:visibility="gone"
                    app:cornerRadius="20dp" />

                <!-- Instructions card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/glass_background">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How it works:"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. On the other device: open app → tap Receive"
                        android:textColor="@color/app_text"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Tap the card above to pick up to 10 files (max 50 GB) — transfer starts automatically"
                        android:textColor="@color/app_text"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Transfers are powered exclusively by Wi-Fi Direct for maximum speed"
                        android:textColor="@color/brand_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>


            <!-- ═══════════════════════════════════════════ -->
            <!-- RECEIVE HOME SCREEN                         -->
            <!-- ═══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutReceiveHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp"
                android:visibility="gone">

                <!-- Back Button row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:id="@+id/btnReceiveBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="‹ Back"
                        android:textColor="@color/brand_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:layout_alignParentStart="true" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📥 Receive Mode"
                        android:textColor="@color/app_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_centerInParent="true" />
                </RelativeLayout>

                <!-- Pulsating Receive Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/glass_background_color"
                    app:strokeColor="@color/brand_primary"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="40dp">

                        <!-- Pulsating circles -->
                        <FrameLayout
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_marginBottom="28dp">

                            <View
                                android:id="@+id/receiveWave1"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_gravity="center"
                                android:background="@drawable/liquid_pulse_circle" />

                            <View
                                android:id="@+id/receiveWave2"
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_gravity="center"
                                android:background="@drawable/liquid_pulse_circle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📥"
                                android:textSize="32sp"
                                android:layout_gravity="center" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ready to Receive"
                            android:textColor="@color/app_text"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Waiting for sender to discover..."
                            android:textColor="@color/app_text_secondary"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:layout_marginTop="10dp" />

                        <TextView
                            android:id="@+id/txtReceiveStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bluetooth active"
                            android:textColor="@color/brand_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="16dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Keep this screen open while receiving"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="12sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════ -->
            <!-- CONNECTING SCREEN                           -->
            <!-- ═══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutConnecting"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <!-- Phones + wave animation row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="48dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱"
                        android:textSize="52sp" />

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginHorizontal="12dp">

                        <View
                            android:id="@+id/waveCircle1"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center"
                            android:background="@drawable/liquid_pulse_circle" />

                        <View
                            android:id="@+id/waveCircle2"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:background="@drawable/liquid_pulse_circle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="◉"
                            android:textColor="@color/brand_primary"
                            android:textSize="26sp"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱"
                        android:textSize="52sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Searching for devices"
                    android:textColor="@color/app_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLE DISCOVERY"
                    android:textColor="@color/brand_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.25"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:id="@+id/txtConnectingState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connecting..."
                    android:textColor="@color/app_text_secondary"
                    android:textSize="15sp"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelConnecting"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:text="Cancel"
                    android:textColor="@color/app_text_secondary"
                    app:strokeColor="@color/glass_stroke_color"
                    app:strokeWidth="1dp"
                    app:cornerRadius="16dp" />

            </LinearLayout>

            <!-- ═══════════════════════════════════════════ -->
            <!-- TRANSFER PROGRESS SCREEN                    -->
            <!-- ═══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutTransfer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_space_planet"
                android:padding="24dp"
                android:visibility="gone">

                <!-- Glassmorphic Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/transferGlassCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1AFFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <!-- Close button top right -->
                        <ImageView
                            android:id="@+id/btnCancelTransfer"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:background="@drawable/glass_background"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="#B3FFFFFF"
                            android:contentDescription="Cancel Transfer" />

                        <!-- Folder Icon + Text Row -->
                        <LinearLayout
                            android:id="@+id/folderRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="32dp">

                            <!-- Folder Icon Container -->
                            <RelativeLayout
                                android:layout_width="80dp"
                                android:layout_height="80dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_premium_folder" />

                                <!-- FILES Badge over folder -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/glass_background"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="4dp"
                                    android:text="FILES"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="20dp">

                                <TextView
                                    android:id="@+id/txtTransferFileName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Project Docs Folder"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:maxLines="2"
                                    android:ellipsize="end" />

                                <TextView
                                    android:id="@+id/txtTransferFileSize"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="80MB"
                                    android:textColor="#99FFFFFF"
                                    android:textSize="14sp"
                                    android:layout_marginTop="4dp" />

                                <!-- Hidden fields for logic compatibility -->
                                <TextView
                                    android:id="@+id/txtTransferDirection"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                                <TextView
                                    android:id="@+id/txtTransferSpeed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                                <TextView
                                    android:id="@+id/txtTransferTimeRemaining"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Progress Bar Container -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/folderRow"
                            android:background="@drawable/glass_background"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_alignParentStart="true">
                                    
                                    <ProgressBar
                                        android:id="@+id/progressSpinner"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginEnd="8dp"
                                        android:indeterminate="true"
                                        android:indeterminateTint="#FFFFFF" />

                                    <TextView
                                        android:id="@+id/txtStatusTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Uploading ..."
                                        android:textColor="#FFFFFF"
                                        android:textSize="16sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/txtTransferPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="73%"
                                    android:textColor="#FFFFFF"
                                    android:textSize="22sp"
                                    android:textStyle="normal" />

                            </RelativeLayout>

                            <ProgressBar
                                android:id="@+id/progressBarTransfer"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:max="100"
                                android:progress="73"
                                android:progressDrawable="@drawable/premium_progress_horizontal" />

                        </LinearLayout>

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════ -->
            <!-- FINISHED SCREEN                             -->
            <!-- ═══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutFinished"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginBottom="36dp">

                    <View
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_gravity="center"
                        android:background="@drawable/glass_background"
                        android:backgroundTint="@color/brand_primary_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textColor="@color/brand_primary"
                        android:textSize="68sp"
                        android:textStyle="bold"
                        android:layout_gravity="center" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transfer Complete"
                    android:textColor="@color/app_text"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtFinishedMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="File saved successfully"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="15sp"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinishedDone"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="56dp"
                    android:text="Done"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/brand_primary"
                    app:cornerRadius="16dp"
                    android:paddingVertical="14dp" />

            </LinearLayout>

        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
